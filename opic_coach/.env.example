# 이 파일을 복사해서 .env 로 이름을 바꾸고 키를 넣으세요. (.env 는 git에 올라가지 않아요)
OPENAI_API_KEY=sk-여기에-키를-넣으세요

# 선택: 사용할 모델 (https://platform.openai.com/docs/models 에서 최신 이름 확인)
# OPIC_MODEL=gpt-5.4-mini
# 선택: 피드백 깊이 low(빠름) / medium / high(자세함). 추론 모델이 아니면 비워두세요.
# OPIC_EFFORT=low
# 선택: 음성 인식 모델 (안 되면 whisper-1 로 자동 전환)
# OPIC_STT_MODEL=gpt-4o-mini-transcribe
